<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Sidebar -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/black"
        android:paddingTop="60dp"
        android:paddingBottom="60dp">

        <!-- Expand/Collapse arrow -->
        <ImageButton
            android:id="@+id/btnExpand"
            android:layout_width="56dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_right"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Expand sidebar" />

        <!-- Home -->
        <LinearLayout
            android:id="@+id/mini_nav_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_home"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Chat -->
        <LinearLayout
            android:id="@+id/mini_nav_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_chat"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Code -->
        <LinearLayout
            android:id="@+id/mini_nav_code"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_code"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Memes -->
        <LinearLayout
            android:id="@+id/mini_nav_memes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_memes"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_memes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memes"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Q&A -->
        <LinearLayout
            android:id="@+id/mini_nav_qa"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_qa"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_qa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q&amp;A"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Repos -->
        <LinearLayout
            android:id="@+id/mini_nav_repo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_repos"
                app:tint="@color/white"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:id="@+id/label_repo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repos"
                android:textColor="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Settings -->
        <!-- Settings -->
        <LinearLayout
            android:id="@+id/mini_nav_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_profile_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/avatar_circle"
                    android:text=""/>

                <ImageView
                    android:id="@+id/iv_profile_pic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:scaleType="centerCrop"/>

            </FrameLayout>

            <TextView
                android:id="@+id/label_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textColor="@color/white"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Fragment content area -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>

</LinearLayout>